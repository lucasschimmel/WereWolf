{
  "name": "werewolf",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "cd apps/game && vite --host 0.0.0.0",
    "shots": "bun scripts/mobile-shots.ts",
    "playtest":"node --env-file-if-exists=apps/game/.env.local scripts/playtest.ts",
    "build": "cd apps/game && vite build",
    "relay": "cd apps/relay && wrangler dev --port 8787 --ip 127.0.0.1",
    "check": "biome check . && tsc --noEmit -p apps/game/tsconfig.json && cd apps/relay && wrangler types && tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2",
    "@playwright/test": "^1.65.1"
  }
}
